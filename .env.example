# Скопируйте в .env и впишите свои значения. Файл .env в git НЕ попадает.

# Pinecone
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX_NAME=memory-bot-test
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# OpenAI (или совместимый прокси)
OPENAI_API_KEY=your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Telegram (токен от @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-token

# Порог косинусного сходства (необязательно)
# >= SIMILARITY_THRESHOLD       -> дубликат/вариация: 'updated'
# >= SIMILARITY_SKIP_THRESHOLD  -> почти точный повтор: 'skipped'
SIMILARITY_THRESHOLD=0.6
SIMILARITY_SKIP_THRESHOLD=0.97
